<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ListView
        android:id="@+id/playlist"
        style="@style/playlist"
        android:layout_width="415dp"
        android:layout_height="648dp"
        android:fastScrollEnabled="true"
        app:layout_constraintBottom_toTopOf="@id/rew"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ÉLÉMENT 2 : Boutons de contrôle (Chaîne Horizontale) -->

    <!-- ÉLÉMENT 3 : Options de Mode (alignés verticalement avec les boutons) -->

    <ImageButton
        android:id="@+id/rew"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="72dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@id/progressBar"
        app:layout_constraintEnd_toStartOf="@+id/play"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlist"
        app:srcCompat="@drawable/ic_action_rewind"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="650dp" />

    <!-- ÉLÉMENT 4 : Barre de progression et compteurs de temps -->

    <ImageButton
        android:id="@+id/play"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="78dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@id/rew"
        app:layout_constraintEnd_toStartOf="@+id/fwd"
        app:layout_constraintStart_toEndOf="@id/rew"
        app:layout_constraintTop_toTopOf="@id/rew"
        app:srcCompat="@drawable/ic_action_play"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="650dp" />

    <ImageButton
        android:id="@+id/fwd"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="72dp"
        android:layout_height="35dp"
        app:layout_constraintBottom_toBottomOf="@id/rew"
        app:layout_constraintEnd_toStartOf="@+id/mode_label"
        app:layout_constraintStart_toEndOf="@id/play"
        app:layout_constraintTop_toTopOf="@id/rew"
        app:srcCompat="@drawable/ic_action_skip"
        tools:layout_editor_absoluteX="150dp"
        tools:layout_editor_absoluteY="646dp" />

    <TextView
        android:id="@+id/mode_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/switch_mode"
        android:textColor="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="@id/rew"
        app:layout_constraintEnd_toStartOf="@+id/mode"
        app:layout_constraintStart_toEndOf="@id/fwd"
        app:layout_constraintTop_toTopOf="@id/rew"
        tools:layout_editor_absoluteX="222dp"
        tools:layout_editor_absoluteY="661dp" />

    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/mode"
        android:layout_width="93dp"
        android:layout_height="36dp"
        android:textOff="@string/switch_mode_track"
        android:textOn="@string/switch_mode_album"
        app:layout_constraintBottom_toBottomOf="@id/rew"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mode_label"
        app:layout_constraintTop_toTopOf="@id/rew"
        tools:layout_editor_absoluteX="313dp"
        tools:layout_editor_absoluteY="646dp" />

    <TextView
        style="@style/track"
        android:id="@+id/position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/progressBar" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="411dp"
        android:layout_height="17dp"
        app:layout_constraintBottom_toTopOf="@id/infoMsg"
        app:layout_constraintEnd_toStartOf="@id/duration"
        app:layout_constraintStart_toEndOf="@id/position"
        app:layout_constraintTop_toBottomOf="@id/rew"
        tools:layout_editor_absoluteX="-5dp"
        tools:layout_editor_absoluteY="681dp" />

    <TextView
        style="@style/track"
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toEndOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ÉLÉMENT 5 : Message d'information tout en bas -->
    <TextView
        style="@style/info"
        android:id="@+id/infoMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:maxLines="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>